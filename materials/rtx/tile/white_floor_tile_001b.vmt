PBR
{
	$basetexture "rtx/tile/white_floor_tile_001b"
	$mraotexture "rtx/tile/white_floor_tile_mrao"
	$bumpmap "rtx/tile/white_floor_tile_normal"
	//$reflectivity "[0.566 0.590 0.590]"
	$reflectivity "[.44 .46 .46]"
	$basetexturetransform "center .5 .5 scale 8 8 rotate 90 translate 0 0"
	//rotated to align color values with vanilla P1 (the dark and light tiles are swapped in the RTX textures)
	$mraoscale "[1 1 1]"
	$surfaceprop metal
}