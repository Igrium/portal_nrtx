PBR
{
	$basetexture "rtx/metal/metalwall_001a"
	$mraotexture "rtx/metal/metalwall_001a_mrao"
	$bumpmap "rtx/metal/metalwall_001a_normal"
	$basetexturetransform "center .5 .5 scale 8 8 rotate 0 translate 0 0"
	$mraoscale "[1 1 1]"
	%noportal 1

	$parallax 1
	$parallaxdepth 0.025
	$parallaxdither 1
	$parallaxcenter 0.25

	$surfaceprop metal
}