PBR
{
    $model 0
    // $basetexturetransform "center .5 .5 scale 4 4 rotate 0 translate 0 0"
    $translucent 1
    $decal 1

    $basetexture    "overlays/overlay_scrawlings006a/overlay_scrawlings006a_color"
    $mraotexture    "overlays/overlay_scrawlings006a/overlay_scrawlings006a_mrao"
    $bumpmap        "overlays/overlay_scrawlings006a/overlay_scrawlings006a_normal"

    $envmap env_cubemap
    $keywords "portal"
    $decalscale 0.25
}