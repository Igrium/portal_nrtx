"PBR"
{
    $model 0
    $basetexturetransform "center .5 .5 scale 4 4 rotate 0 translate 0 0"

    $basetexture    "metal/metal_lift001/metal_lift001_color"
    $bumpmap        "metal/metal_lift001/metal_lift001_normal"
    $mraotexture    "metal/metal_lift001/metal_lift001_mrao"

    $envmap env_cubemap

    "$surfaceprop" "metal"
    "%keywords" "portal"
    "%noportal" 1
}