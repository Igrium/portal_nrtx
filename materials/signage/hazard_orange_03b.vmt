PBR
{
    $model 0
    $basetexturetransform "center .5 .5 scale 8 8 rotate 0 translate 0 0"
    $surfaceprop "glass"

    $basetexture    "signage/hazard_orange_03b/hazard_orange_03b_color"
    $mraotexture    "signage/hazard_orange_03b/hazard_orange_03b_mrao"
    $bumpmap        "signage/hazard_orange_03b/hazard_orange_03b_normal"
    $emissiontexture "signage/hazard_orange_03b/hazard_orange_03b_selfillum"

    $envmap env_cubemap
    "%keywords" "portal "
}