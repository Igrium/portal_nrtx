PBR
{
    $model          1

    $basetexture    "models/props/light_rail_endcap/light_rail_endcap_color"
    $mraotexture    "models/props/light_rail_endcap/light_rail_endcap_mrao"
    $bumpmap        "models/props/light_rail_endcap/light_rail_endcap_normal"
    $emissiontexture "models/props/light_rail_endcap/light_rail_endcap_selfillum"

    $emissionscale  1
    $envmap         env_cubemap
}