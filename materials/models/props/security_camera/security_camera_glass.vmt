Refract
{
	$refractamount .05
	$normalmap "models/props/security_camera/security_camera_normal"
	$envmap "env_cubemap"
	$fresnelreflection 0.25
	$envmapmask "models/props/security_camera/security_camera_refracttint"
	$model 1
	$nowritez 1
	$envmaptint "[1 1 .9]"
	$refracttinttexture "models/props/security_camera/security_camera"
	//$bluramount 0
}