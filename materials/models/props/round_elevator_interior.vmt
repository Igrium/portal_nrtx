PBR
{
    $model          1
    $basetexture    "models/props/round_elevator/round_elevator_interior_color"
    $mraotexture    "models/props/round_elevator/round_elevator_interior_mrao"
    $bumpmap        "models/props/round_elevator/round_elevator_interior_normal"

    $emissiontexture "models/props/round_elevator/round_elevator_interior_indirect"
    $emissionscale   .6

    $envmap "cubemaps/cubemap_elevator"
}   